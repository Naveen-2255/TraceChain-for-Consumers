{
  "expo": {
    "name": "TraceChain",
    "slug": "tracechain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F2EA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TraceChain uses the camera to scan product QR codes and verify supply chain authenticity."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6B734A"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TraceChain to access your camera to scan product QR codes."
        }
      ]
    ]
  }
}
